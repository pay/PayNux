+
+        // ================= USULAN (BELUM DITERAPKAN) =================
+        // Strip 16dp di tepi kiri: view overlay TERPISAH dengan touch
+        // listener sendiri. Listener sentuh terminal TIDAK disentuh.
+        // Catatan: gestur back Android 10+ bisa merebut geseran dari tepi
+        // kiri, dan area ini tidak bisa dipakai untuk memulai seleksi teks.
+        View edgeStrip = new View(this);
+        edgeStrip.setBackgroundColor(Color.TRANSPARENT);
+        edgeStrip.setOnTouchListener((v, ev) -> {
+            switch (ev.getActionMasked()) {
+                case android.view.MotionEvent.ACTION_DOWN:
+                    edgeStartX = ev.getX();
+                    edgeStartY = ev.getY();
+                    return true;                 // konsumsi: tidak sampai ke terminal
+                case android.view.MotionEvent.ACTION_UP: {
+                    float dx = ev.getX() - edgeStartX;
+                    float dy = Math.abs(ev.getY() - edgeStartY);
+                    if (dx > dp(24) && dy < dp(40)) showSessionList();
+                    return true;
+                }
+                default:
+                    return true;
+            }
+        });
+        android.widget.FrameLayout.LayoutParams edgeLp =
+                new android.widget.FrameLayout.LayoutParams(dp(16),
+                        android.widget.FrameLayout.LayoutParams.MATCH_PARENT,
+                        Gravity.START);
+        edgeLp.setMargins(0, dp(44), 0, dp(KEY_H_DP * 2 + 8));
+        frame.addView(edgeStrip, edgeLp);
+        // =============== AKHIR USULAN (BELUM DITERAPKAN) ===============
+
         setContentView(frame);
 
